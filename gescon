#!/bin/sh
# gescon -- sobe o GesCon para desenvolvimento: interface web em
# http://127.0.0.1:8086 com o banco de ADVPP_DB (padrão ~/.advpp/ADVPP.db).
# Para uso no condomínio, o pacote (packaging/build-package.sh) traz o
# iniciador que faz isto sozinho e abre o navegador.
#
# Primeira vez num banco vazio: defina GESCON_ADMIN_SENHA (senha inicial do
# usuário admin, troca obrigatória no primeiro acesso).
cd "$(dirname "$0")" || exit 1
exec advplc serve gescon.prw --port "${GESCON_PORTA:-8086}" "$@"
