#!/bin/sh
# gescon -- abre o GesCon em janela desktop (Fyne).
#
# Desde que o build usa `advplc build --gui`, o proprio executavel ja abre a
# janela -- este script virou conveniencia. ADVPP_FORCE_GUI=1 fica como cinto
# de seguranca para binario antigo, compilado sem a flag, que lancado de um
# terminal cairia na UI de terminal e quebraria todo formulario com
# "MSDIALOG: requer o modo web". Ver docs/PADRAO_GUI.md, secao 4.
set -e

DIR="$(dirname "$0")"
APP="${GESCON_APP:-$DIR/GesConApp}"

if [ ! -x "$APP" ]; then
    echo "GesCon: executavel nao encontrado em $APP" >&2
    echo "Gere com: scripts/build.sh" >&2
    exit 1
fi

ADVPP_FORCE_GUI=1 exec "$APP" "$@"
