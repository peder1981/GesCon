    AAdd(aLinhas, "    EXE_FECHADO NUMERIC DEFAULT 0,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ NUMERIC")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "CREATE INDEX IF NOT EXISTS IDX_EXERCICIO_ATIVO ON EXERCICIO(EXE_ATIVO, EXE_FECHADO, D_E_L_E_T_);")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS LANCAMENTOS (")
    AAdd(aLinhas, "    LAN_ID INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "    LAN_DATA DATE NOT NULL,")
    AAdd(aLinhas, "    LAN_CONTA_DEB TEXT NOT NULL,")
    AAdd(aLinhas, "    LAN_CONTA_CRED TEXT NOT NULL,")
    AAdd(aLinhas, "    LAN_VALOR NUMERIC NOT NULL,")
    AAdd(aLinhas, "    LAN_DESCR TEXT,")
    AAdd(aLinhas, "    LAN_REFERENCIA NUMERIC,")
    AAdd(aLinhas, "    LAN_TIPO TEXT NOT NULL,")
    AAdd(aLinhas, "    LAN_DATA_HORA DATETIME,")
    AAdd(aLinhas, "    LAN_USUARIO TEXT,")
    AAdd(aLinhas, "    LAN_EXERCICIO TEXT NOT NULL,")
    AAdd(aLinhas, "    R_E_C_N_O_ INTEGER,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ NUMERIC,")
    AAdd(aLinhas, "    FOREIGN KEY(LAN_CONTA_DEB) REFERENCES PLANO_CONTAS(PLA_CODIGO),")
    AAdd(aLinhas, "    FOREIGN KEY(LAN_CONTA_CRED) REFERENCES PLANO_CONTAS(PLA_CODIGO),")
    AAdd(aLinhas, "    FOREIGN KEY(LAN_EXERCICIO) REFERENCES EXERCICIO(EXE_CODIGO),")
    AAdd(aLinhas, "    CHECK(LAN_VALOR > 0),")
    AAdd(aLinhas, "    CHECK(LAN_TIPO IN ('MANUAL', 'AUTOMATICO_DESPESA', 'AUTOMATICO_RATEIO')),")
    AAdd(aLinhas, "    CHECK(LAN_CONTA_DEB != LAN_CONTA_CRED)")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "CREATE INDEX IF NOT EXISTS IDX_LANCAMENTOS_EXERCICIO ON LANCAMENTOS(LAN_EXERCICIO, D_E_L_E_T_);")
