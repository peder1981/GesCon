    AAdd(aLinhas, "('AVISOS', 2, 'AVI_TITULO',        'C', 255, 0, 'Título'),")
    AAdd(aLinhas, "('AVISOS', 3, 'AVI_CORPO',         'M',   0, 0, 'Corpo'),")
    AAdd(aLinhas, "('AVISOS', 4, 'AVI_DATA_CRIACAO',  'C',  19, 0, 'Data Criação'),")
    AAdd(aLinhas, "('AVISOS', 5, 'AVI_ATIVO',         'N',   1, 0, 'Ativo');")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- Metadados SX3 para RPT_PORTAL_EXTRATOS")
    AAdd(aLinhas, "INSERT INTO SX3 (X3_ARQUIVO, X3_ORDEM, X3_CAMPO, X3_TIPO, X3_TAMANHO, X3_DECIMAL, X3_TITULO) VALUES")
    AAdd(aLinhas, "('RPT_PORTAL_EXTRATOS', 1, 'REX_ID',              'N',  10, 0, 'ID Extrato'),")
    AAdd(aLinhas, "('RPT_PORTAL_EXTRATOS', 2, 'REX_COMPETENCIA',    'C',   7, 0, 'Competência'),")
    AAdd(aLinhas, "('RPT_PORTAL_EXTRATOS', 3, 'REX_UNIDADE',        'C',  10, 0, 'Unidade'),")
    AAdd(aLinhas, "('RPT_PORTAL_EXTRATOS', 4, 'REX_VALOR',          'N',  14, 2, 'Valor'),")
    AAdd(aLinhas, "('RPT_PORTAL_EXTRATOS', 5, 'REX_VENCIMENTO',     'D',  10, 0, 'Vencimento'),")
    AAdd(aLinhas, "('RPT_PORTAL_EXTRATOS', 6, 'REX_STATUS',         'C',  10, 0, 'Status'),")
    AAdd(aLinhas, "('RPT_PORTAL_EXTRATOS', 7, 'REX_DATA_PAGAMENTO', 'D',  10, 0, 'Data Pagamento');")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- Metadados SX3 para RPT_PORTAL_AGENDA")
    AAdd(aLinhas, "INSERT INTO SX3 (X3_ARQUIVO, X3_ORDEM, X3_CAMPO, X3_TIPO, X3_TAMANHO, X3_DECIMAL, X3_TITULO) VALUES")
    AAdd(aLinhas, "('RPT_PORTAL_AGENDA', 1, 'REA_ID',          'N',  10, 0, 'ID Agenda'),")
    AAdd(aLinhas, "('RPT_PORTAL_AGENDA', 2, 'REA_UNIDADE',     'C',  10, 0, 'Unidade'),")
    AAdd(aLinhas, "('RPT_PORTAL_AGENDA', 3, 'REA_COMPETENCIA', 'C',   7, 0, 'Competência'),")
    AAdd(aLinhas, "('RPT_PORTAL_AGENDA', 4, 'REA_VENCIMENTO',  'D',  10, 0, 'Vencimento'),")
    AAdd(aLinhas, "('RPT_PORTAL_AGENDA', 5, 'REA_VALOR',       'N',  14, 2, 'Valor');")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- ANOMALIA_LOG: histÃ³rico de anomalias detectadas")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS ANOMALIA_LOG (")
    AAdd(aLinhas, "  ANL_ID INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "  ANL_TIPO TEXT NOT NULL,")
    AAdd(aLinhas, "  ANL_PERIODO TEXT NOT NULL,")
    AAdd(aLinhas, "  ANL_UNIDADE TEXT,")
    AAdd(aLinhas, "  ANL_VALOR NUMERIC,")
    AAdd(aLinhas, "  ANL_DESCRICAO TEXT,")
    AAdd(aLinhas, "  ANL_LANCAMENTO_ID INTEGER,")
    AAdd(aLinhas, "  ANL_COBRANCA_ID INTEGER,")
    AAdd(aLinhas, "  ANL_CRIADO_EM DATETIME DEFAULT CURRENT_TIMESTAMP,")
    AAdd(aLinhas, "  ANL_RESOLVIDO_EM DATETIME,")
    AAdd(aLinhas, "  ANL_STATUS TEXT DEFAULT 'ABERTO' CHECK(ANL_STATUS IN ('ABERTO', 'RESOLVIDO', 'IGNORADO')),")
    AAdd(aLinhas, "  R_E_C_N_O_ INTEGER UNIQUE,")
    AAdd(aLinhas, "  D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "  R_E_C_D_E_L_ NUMERIC")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "CREATE INDEX IF NOT EXISTS IDX_ANOMALIA_TIPO ON ANOMALIA_LOG(ANL_TIPO, D_E_L_E_T_);")
    AAdd(aLinhas, "CREATE INDEX IF NOT EXISTS IDX_ANOMALIA_PERIODO ON ANOMALIA_LOG(ANL_PERIODO, D_E_L_E_T_);")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- ALERTA: notificaÃ§Ãµes crÃ­ticas em tempo real")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS ALERTA (")
    AAdd(aLinhas, "  ALT_ID INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "  ALT_TIPO TEXT NOT NULL CHECK(ALT_TIPO IN ('CRITICO', 'AVISO', 'INFO')),")
    AAdd(aLinhas, "  ALT_ANOMALIA_ID INTEGER,")
    AAdd(aLinhas, "  ALT_MENSAGEM TEXT NOT NULL,")
    AAdd(aLinhas, "  ALT_CRIADO_EM DATETIME DEFAULT CURRENT_TIMESTAMP,")
    AAdd(aLinhas, "  ALT_VISTO INTEGER DEFAULT 0,")
    AAdd(aLinhas, "  ALT_VISTO_EM DATETIME,")
    AAdd(aLinhas, "  R_E_C_N_O_ INTEGER UNIQUE,")
    AAdd(aLinhas, "  D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "  R_E_C_D_E_L_ NUMERIC,")
    AAdd(aLinhas, "  FOREIGN KEY(ALT_ANOMALIA_ID) REFERENCES ANOMALIA_LOG(ANL_ID)")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "CREATE INDEX IF NOT EXISTS IDX_ALERTA_TIPO ON ALERTA(ALT_TIPO, ALT_VISTO, D_E_L_E_T_);")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- DASHBOARD_CACHE: snapshot diÃ¡rio para performance")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS DASHBOARD_CACHE (")
    AAdd(aLinhas, "  DSH_ID INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "  DSH_DATA DATE NOT NULL,")
    AAdd(aLinhas, "  DSH_PERIODO TEXT NOT NULL,")
    AAdd(aLinhas, "  DSH_ANOMALIAS_TOTAL NUMERIC,")
    AAdd(aLinhas, "  DSH_DESEQUILIBRIO_COUNT NUMERIC,")
    AAdd(aLinhas, "  DSH_LAN_ORFAO_COUNT NUMERIC,")
    AAdd(aLinhas, "  DSH_COB_ORFAO_COUNT NUMERIC,")
    AAdd(aLinhas, "  DSH_RATEIO_INVALID_COUNT NUMERIC,")
    AAdd(aLinhas, "  DSH_TIMING_COUNT NUMERIC,")
    AAdd(aLinhas, "  DSH_USUARIO_COUNT NUMERIC,")
    AAdd(aLinhas, "  DSH_JSON TEXT,")
    AAdd(aLinhas, "  DSH_ATUALIZADO_EM DATETIME,")
    AAdd(aLinhas, "  R_E_C_N_O_ INTEGER UNIQUE,")
    AAdd(aLinhas, "  D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "  R_E_C_D_E_L_ NUMERIC")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "CREATE UNIQUE INDEX IF NOT EXISTS IDX_DASHBOARD_DATA_PERIODO ON DASHBOARD_CACHE(DSH_DATA, DSH_PERIODO, D_E_L_E_T_);")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- Metadados SX3 para TOK_PERFIL")
    AAdd(aLinhas, "INSERT INTO SX3 (X3_ARQUIVO, X3_ORDEM, X3_CAMPO, X3_TIPO, X3_TAMANHO, X3_DECIMAL, X3_TITULO) VALUES")
    AAdd(aLinhas, "('GCT_TOKEN', 8, 'TOK_PERFIL', 'C', 20, 0, 'Perfil do Token');")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- ============================================================================")
    AAdd(aLinhas, "-- Metadados SX3 das tabelas de auditoria (Portal v3)")
    AAdd(aLinhas, "-- Sem estas linhas o FWMBrowse abre ANOMALIA_LOG, ALERTA e DASHBOARD_CACHE")
    AAdd(aLinhas, "-- sem coluna nenhuma -- as telas do menu Auditoria dependem disto.")
    AAdd(aLinhas, "-- ============================================================================")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "DELETE FROM SX3 WHERE X3_ARQUIVO IN ('ANOMALIA_LOG','ALERTA','DASHBOARD_CACHE');")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "INSERT INTO SX3 (X3_ARQUIVO, X3_ORDEM, X3_CAMPO, X3_TIPO, X3_TAMANHO, X3_DECIMAL, X3_TITULO) VALUES")
    AAdd(aLinhas, "('ANOMALIA_LOG', 1, 'ANL_ID',            'N', 10, 0, 'ID'),")
    AAdd(aLinhas, "('ANOMALIA_LOG', 2, 'ANL_TIPO',          'C', 40, 0, 'Tipo'),")
    AAdd(aLinhas, "('ANOMALIA_LOG', 3, 'ANL_PERIODO',       'C',  7, 0, 'Período'),")
    AAdd(aLinhas, "('ANOMALIA_LOG', 4, 'ANL_UNIDADE',       'C', 20, 0, 'Unidade'),")
    AAdd(aLinhas, "('ANOMALIA_LOG', 5, 'ANL_VALOR',         'N', 14, 2, 'Valor'),")
    AAdd(aLinhas, "('ANOMALIA_LOG', 6, 'ANL_DESCRICAO',     'C',255, 0, 'Descrição'),")
    AAdd(aLinhas, "('ANOMALIA_LOG', 7, 'ANL_LANCAMENTO_ID', 'N', 10, 0, 'Lançamento'),")
    AAdd(aLinhas, "('ANOMALIA_LOG', 8, 'ANL_COBRANCA_ID',   'N', 10, 0, 'Cobrança'),")
    AAdd(aLinhas, "('ANOMALIA_LOG', 9, 'ANL_CRIADO_EM',     'C', 19, 0, 'Detectada em'),")
    AAdd(aLinhas, "('ANOMALIA_LOG',10, 'ANL_RESOLVIDO_EM',  'C', 19, 0, 'Resolvida em'),")
    AAdd(aLinhas, "('ANOMALIA_LOG',11, 'ANL_STATUS',        'C', 20, 0, 'Status');")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "INSERT INTO SX3 (X3_ARQUIVO, X3_ORDEM, X3_CAMPO, X3_TIPO, X3_TAMANHO, X3_DECIMAL, X3_TITULO) VALUES")
    AAdd(aLinhas, "('ALERTA', 1, 'ALT_ID',          'N', 10, 0, 'ID'),")
    AAdd(aLinhas, "('ALERTA', 2, 'ALT_TIPO',        'C', 20, 0, 'Tipo'),")
    AAdd(aLinhas, "('ALERTA', 3, 'ALT_ANOMALIA_ID', 'N', 10, 0, 'Anomalia'),")
    AAdd(aLinhas, "('ALERTA', 4, 'ALT_MENSAGEM',    'C',255, 0, 'Mensagem'),")
    AAdd(aLinhas, "('ALERTA', 5, 'ALT_CRIADO_EM',   'C', 19, 0, 'Criado em'),")
    AAdd(aLinhas, "('ALERTA', 6, 'ALT_VISTO',       'N',  1, 0, 'Visto'),")
    AAdd(aLinhas, "('ALERTA', 7, 'ALT_VISTO_EM',    'C', 19, 0, 'Visto em');")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "INSERT INTO SX3 (X3_ARQUIVO, X3_ORDEM, X3_CAMPO, X3_TIPO, X3_TAMANHO, X3_DECIMAL, X3_TITULO) VALUES")
    AAdd(aLinhas, "('DASHBOARD_CACHE', 1, 'DSH_ID',                  'N', 10, 0, 'ID'),")
    AAdd(aLinhas, "('DASHBOARD_CACHE', 2, 'DSH_DATA',                'C', 10, 0, 'Data'),")
    AAdd(aLinhas, "('DASHBOARD_CACHE', 3, 'DSH_PERIODO',             'C',  7, 0, 'Período'),")
    AAdd(aLinhas, "('DASHBOARD_CACHE', 4, 'DSH_ANOMALIAS_TOTAL',     'N', 10, 0, 'Total'),")
    AAdd(aLinhas, "('DASHBOARD_CACHE', 5, 'DSH_DESEQUILIBRIO_COUNT', 'N', 10, 0, 'Desequilíbrio'),")
    AAdd(aLinhas, "('DASHBOARD_CACHE', 6, 'DSH_LAN_ORFAO_COUNT',     'N', 10, 0, 'Lanç. órfãos'),")
    AAdd(aLinhas, "('DASHBOARD_CACHE', 7, 'DSH_COB_ORFAO_COUNT',     'N', 10, 0, 'Cobr. órfãs'),")
    AAdd(aLinhas, "('DASHBOARD_CACHE', 8, 'DSH_RATEIO_INVALID_COUNT','N', 10, 0, 'Rateio inválido'),")
    AAdd(aLinhas, "('DASHBOARD_CACHE', 9, 'DSH_TIMING_COUNT',        'N', 10, 0, 'Timing'),")
    AAdd(aLinhas, "('DASHBOARD_CACHE',10, 'DSH_USUARIO_COUNT',       'N', 10, 0, 'Usuário'),")
    AAdd(aLinhas, "('DASHBOARD_CACHE',11, 'DSH_ATUALIZADO_EM',       'C', 19, 0, 'Atualizado em');")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- USR_LOGIN faltava: o browse de usuarios abria com uma coluna so.")
    AAdd(aLinhas, "-- USR_SENHA fica fora de proposito -- hash nao se mostra em tela.")
    AAdd(aLinhas, "INSERT INTO SX3 (X3_ARQUIVO, X3_ORDEM, X3_CAMPO, X3_TIPO, X3_TAMANHO, X3_DECIMAL, X3_TITULO) VALUES")
    AAdd(aLinhas, "('USR', 1, 'USR_LOGIN', 'C', 50, 0, 'Login');")

    For nI := 1 To Len(aLinhas)
        cSQL += aLinhas[nI] + Chr(10)
    Next nI
Return cSQL
