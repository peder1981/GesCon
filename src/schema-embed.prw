// src/schema-embed.prw — GERADO por scripts/gen-schema-embed.sh.
//
// NAO EDITE A MAO. A fonte da verdade e schema.sql; este arquivo so o
// carrega para dentro do executavel, porque no primeiro arranque o app tem
// que criar as proprias tabelas sem depender de shell nem de sqlite3.
// scripts/check.sh reprova se os dois sairem de sincronia.
#include "totvs.ch"

/*/{Protheus.doc} GcSchemaSQL
    Devolve o conteudo de schema.sql embutido no executavel.
    @type Function
    @author GesCon (gerado)
    @return cSQL, character, DDL completo, comandos separados por ';'
*/
User Function GcSchemaSQL()
    Local aLinhas := {}
    Local cSQL := ""
    Local nI := 0

    AAdd(aLinhas, "-- GesCon — schema v1. Convenção de exclusão lógica estilo Protheus")
    AAdd(aLinhas, "-- (R_E_C_N_O_/D_E_L_E_T_/R_E_C_D_E_L_), mesma que o AdvEditor usa.")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- Tabela de metadados SX3 (títulos/tipos de coluna pro FWMBrowse).")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS SX3 (")
    AAdd(aLinhas, "    R_E_C_N_O_ INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    X3_ARQUIVO TEXT NOT NULL,")
    AAdd(aLinhas, "    X3_ORDEM  INTEGER NOT NULL,")
    AAdd(aLinhas, "    X3_CAMPO  TEXT NOT NULL,")
    AAdd(aLinhas, "    X3_TIPO   TEXT NOT NULL,")
    AAdd(aLinhas, "    X3_TAMANHO INTEGER NOT NULL,")
    AAdd(aLinhas, "    X3_DECIMAL INTEGER DEFAULT 0,")
    AAdd(aLinhas, "    X3_QUICK  TEXT DEFAULT 'N',")
    AAdd(aLinhas, "    X3_VLADB  TEXT DEFAULT '',")
    AAdd(aLinhas, "    X3_TITULO TEXT")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS CON (")
    AAdd(aLinhas, "    R_E_C_N_O_ INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ INTEGER DEFAULT 0,")
    AAdd(aLinhas, "    CON_CODIGO TEXT NOT NULL,")
    AAdd(aLinhas, "    CON_NOME TEXT NOT NULL,")
    AAdd(aLinhas, "    CON_CPF TEXT,")
    AAdd(aLinhas, "    CON_EMAIL TEXT,")
    AAdd(aLinhas, "    CON_TEL TEXT")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS UNI (")
    AAdd(aLinhas, "    R_E_C_N_O_ INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ INTEGER DEFAULT 0,")
    AAdd(aLinhas, "    UNI_CODIGO TEXT NOT NULL UNIQUE,")
    AAdd(aLinhas, "    UNI_BLOCO TEXT,")
    AAdd(aLinhas, "    UNI_FRACAO REAL NOT NULL DEFAULT 0,")
    AAdd(aLinhas, "    UNI_CONDOMINO TEXT")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- Vínculo unidade->condômino: UNI_CONDOMINO é texto livre na tela (sem")
    AAdd(aLinhas, "-- combo/lookup), então valida na borda do banco em vez de na UI. Rejeita")
    AAdd(aLinhas, "-- código que não existe (ou está excluído) em CON, tanto no Incluir quanto")
    AAdd(aLinhas, "-- no Alterar da tela de Unidades.")
    AAdd(aLinhas, "CREATE TRIGGER IF NOT EXISTS TRG_UNI_CONDOMINO_INS")
    AAdd(aLinhas, "BEFORE INSERT ON UNI")
    AAdd(aLinhas, "WHEN NEW.UNI_CONDOMINO IS NOT NULL AND TRIM(NEW.UNI_CONDOMINO) <> ''")
    AAdd(aLinhas, "BEGIN")
    AAdd(aLinhas, "    SELECT RAISE(ABORT, 'Condômino inexistente: cadastre o condômino antes de vincular a unidade.')")
    AAdd(aLinhas, "    WHERE NOT EXISTS (SELECT 1 FROM CON WHERE CON_CODIGO = NEW.UNI_CONDOMINO AND D_E_L_E_T_ = ' ');")
    AAdd(aLinhas, "END;")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "CREATE TRIGGER IF NOT EXISTS TRG_UNI_CONDOMINO_UPD")
    AAdd(aLinhas, "BEFORE UPDATE OF UNI_CONDOMINO ON UNI")
    AAdd(aLinhas, "WHEN NEW.UNI_CONDOMINO IS NOT NULL AND TRIM(NEW.UNI_CONDOMINO) <> ''")
    AAdd(aLinhas, "BEGIN")
    AAdd(aLinhas, "    SELECT RAISE(ABORT, 'Condômino inexistente: cadastre o condômino antes de vincular a unidade.')")
    AAdd(aLinhas, "    WHERE NOT EXISTS (SELECT 1 FROM CON WHERE CON_CODIGO = NEW.UNI_CONDOMINO AND D_E_L_E_T_ = ' ');")
    AAdd(aLinhas, "END;")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS DES (")
    AAdd(aLinhas, "    R_E_C_N_O_ INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ INTEGER DEFAULT 0,")
    AAdd(aLinhas, "    DES_DESCR TEXT NOT NULL,")
    AAdd(aLinhas, "    DES_CATEG TEXT,")
    AAdd(aLinhas, "    DES_VALOR REAL NOT NULL DEFAULT 0,")
    AAdd(aLinhas, "    DES_COMPET TEXT NOT NULL,")
    AAdd(aLinhas, "    DES_DTLANC TEXT")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS COB (")
    AAdd(aLinhas, "    R_E_C_N_O_ INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ INTEGER DEFAULT 0,")
    AAdd(aLinhas, "    COB_UNIDADE TEXT NOT NULL,")
    AAdd(aLinhas, "    COB_COMPET TEXT NOT NULL,")
    AAdd(aLinhas, "    COB_VALOR REAL NOT NULL DEFAULT 0,")
    AAdd(aLinhas, "    COB_VENCTO TEXT,")
    AAdd(aLinhas, "    COB_STATUS TEXT NOT NULL DEFAULT 'pendente',")
    AAdd(aLinhas, "    COB_DTPAG TEXT")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- Trava de Cobrança: valor, unidade, competência e vencimento só nascem")
    AAdd(aLinhas, "-- pelo Fechamento Mensal e nunca mudam depois — só Registrar Pagamento")
    AAdd(aLinhas, "-- (COB_STATUS/COB_DTPAG) toca o registro em diante. A tela de Cobranças é")
    AAdd(aLinhas, "-- um FWMBrowse cru (Incluir/Alterar/Excluir livres na UI), então a garantia")
    AAdd(aLinhas, "-- só existe se o banco a impuser.")
    AAdd(aLinhas, "CREATE TRIGGER IF NOT EXISTS TRG_COB_TRAVA_VALOR")
    AAdd(aLinhas, "BEFORE UPDATE OF COB_VALOR, COB_UNIDADE, COB_COMPET, COB_VENCTO ON COB")
    AAdd(aLinhas, "WHEN OLD.COB_VALOR <> NEW.COB_VALOR")
    AAdd(aLinhas, "    OR OLD.COB_UNIDADE <> NEW.COB_UNIDADE")
    AAdd(aLinhas, "    OR OLD.COB_COMPET <> NEW.COB_COMPET")
    AAdd(aLinhas, "    OR IFNULL(OLD.COB_VENCTO, '') <> IFNULL(NEW.COB_VENCTO, '')")
    AAdd(aLinhas, "BEGIN")
    AAdd(aLinhas, "    SELECT RAISE(ABORT, 'Cobrança travada: valor, unidade, competência e vencimento não podem ser alterados depois de criados pelo Fechamento. Use Registrar Pagamento para status e data.');")
    AAdd(aLinhas, "END;")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "CREATE TRIGGER IF NOT EXISTS TRG_COB_TRAVA_EXCLUSAO")
    AAdd(aLinhas, "BEFORE UPDATE OF D_E_L_E_T_ ON COB")
    AAdd(aLinhas, "WHEN NEW.D_E_L_E_T_ = '*' AND OLD.D_E_L_E_T_ = ' '")
    AAdd(aLinhas, "BEGIN")
    AAdd(aLinhas, "    SELECT RAISE(ABORT, 'Cobrança não pode ser excluída: é gerada pelo Fechamento Mensal e faz parte do histórico contábil.');")
    AAdd(aLinhas, "END;")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS USR (")
    AAdd(aLinhas, "    R_E_C_N_O_ INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ INTEGER DEFAULT 0,")
    AAdd(aLinhas, "    USR_LOGIN TEXT NOT NULL,")
    AAdd(aLinhas, "    USR_SENHA TEXT NOT NULL,")
    AAdd(aLinhas, "    USR_PERFIL TEXT DEFAULT 'ADMIN'")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- Tabelas de relatório (Plano 2): snapshot recalculado do zero (DELETE +")
    AAdd(aLinhas, "-- INSERT) toda vez que o relatório é aberto, mesmo padrão que")
    AAdd(aLinhas, "-- GcFecharMes já usa pra gravar Cobrança — FWMBrowse só sabe abrir uma")
    AAdd(aLinhas, "-- tabela física por alias (SELECT rowid ..., UPDATE/DELETE ... WHERE")
    AAdd(aLinhas, "-- rowid = ?), não dá pra apontar pra uma query parametrizada ou VIEW sem")
    AAdd(aLinhas, "-- rowid direto. Read-only por convenção, mas tecnicamente editável pela")
    AAdd(aLinhas, "-- mesma limitação já aceita na tela de Cobranças (ver ARQUITETURA.md).")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS RPT_INADIM (")
    AAdd(aLinhas, "    R_E_C_N_O_ INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ INTEGER DEFAULT 0,")
    AAdd(aLinhas, "    RIN_UNIDADE TEXT,")
    AAdd(aLinhas, "    RIN_COMPET TEXT,")
    AAdd(aLinhas, "    RIN_VALOR REAL,")
    AAdd(aLinhas, "    RIN_VENCTO TEXT,")
    AAdd(aLinhas, "    RIN_ATRASO INTEGER")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS RPT_EXTRATO (")
    AAdd(aLinhas, "    R_E_C_N_O_ INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ INTEGER DEFAULT 0,")
    AAdd(aLinhas, "    REX_COMPET TEXT,")
    AAdd(aLinhas, "    REX_VALOR REAL,")
    AAdd(aLinhas, "    REX_VENCTO TEXT,")
    AAdd(aLinhas, "    REX_STATUS TEXT,")
    AAdd(aLinhas, "    REX_DTPAG TEXT")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS RPT_DESCAT (")
    AAdd(aLinhas, "    R_E_C_N_O_ INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ INTEGER DEFAULT 0,")
    AAdd(aLinhas, "    RDC_CATEG TEXT,")
    AAdd(aLinhas, "    RDC_TOTAL REAL")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- GesCon — CFG_BOLETO: configuração do beneficiário para geração de boletos.")
    AAdd(aLinhas, "-- Uma única linha (estilo MV; INSERT/UPDATE direto).")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS CFG_BOLETO (")
    AAdd(aLinhas, "    R_E_C_N_O_ INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ INTEGER DEFAULT 0,")
    AAdd(aLinhas, "    CFG_BANCO TEXT NOT NULL DEFAULT '237',")
    AAdd(aLinhas, "    CFG_AGENCIA TEXT NOT NULL,")
    AAdd(aLinhas, "    CFG_CONTA TEXT NOT NULL,")
    AAdd(aLinhas, "    CFG_COBRT TEXT NOT NULL,")
    AAdd(aLinhas, "    CFG_CARTEIRA TEXT NOT NULL")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- GesCon — GCT_TOKEN: tokens temporários para acesso condômino.")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS GCT_TOKEN (")
    AAdd(aLinhas, "    TOKEN TEXT PRIMARY KEY,")
    AAdd(aLinhas, "    USR_LOGIN TEXT NOT NULL,")
    AAdd(aLinhas, "    CON_CODIGO TEXT NOT NULL,")
    AAdd(aLinhas, "    UNI_CODIGO TEXT NOT NULL,")
    AAdd(aLinhas, "    CRIPTADO TEXT NOT NULL,")
    AAdd(aLinhas, "    VALIDO_ATE TEXT NOT NULL,")
    AAdd(aLinhas, "    USADO INTEGER DEFAULT 0,")
    AAdd(aLinhas, "    TOK_PERFIL TEXT,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ INTEGER DEFAULT 0")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- GesCon — RPT_COND_COBRANCAS: snapshot de cobranças filtrado por unidade")
    AAdd(aLinhas, "-- (para acesso read-only do condômino via portal).")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS RPT_COND_COBRANCAS (")
    AAdd(aLinhas, "    RCC_UNIDADE TEXT NOT NULL,")
    AAdd(aLinhas, "    RCC_COMPET TEXT NOT NULL,")
    AAdd(aLinhas, "    RCC_VALOR REAL,")
    AAdd(aLinhas, "    RCC_VENCTO TEXT,")
    AAdd(aLinhas, "    RCC_STATUS TEXT,")
    AAdd(aLinhas, "    RCC_DTPAG TEXT,")
    AAdd(aLinhas, "    R_E_C_N_O_ INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ INTEGER DEFAULT 0")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- Metadados SX3 (títulos/tipos de coluna pro FWMBrowse — ver browseColumns")
    AAdd(aLinhas, "-- em pkg/vm/browse.go do AdvPP: sem essas linhas, o browse cai no fallback")
    AAdd(aLinhas, "-- de mostrar toda coluna física como texto, sem título amigável).")
    AAdd(aLinhas, "-- Limpa TUDO antes de reinserir: o SX3 e metadado, reconstruido por inteiro")
    AAdd(aLinhas, "-- por este arquivo. A lista de X3_ARQUIVO que existia aqui cobria 11 das 24")
    AAdd(aLinhas, "-- tabelas, entao cada bootstrap repetido duplicava as outras 13 -- o banco de")
    AAdd(aLinhas, "-- desenvolvimento chegou a ter 4 copias de cada coluna de AVISOS.")
    AAdd(aLinhas, "DELETE FROM SX3;")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "INSERT INTO SX3 (X3_ARQUIVO, X3_ORDEM, X3_CAMPO, X3_TIPO, X3_TAMANHO, X3_DECIMAL, X3_TITULO) VALUES")
    AAdd(aLinhas, "('CON', 1, 'CON_CODIGO', 'C', 10, 0, 'Código'),")
    AAdd(aLinhas, "('CON', 2, 'CON_NOME',   'C', 60, 0, 'Nome'),")
    AAdd(aLinhas, "('CON', 3, 'CON_CPF',    'C', 14, 0, 'CPF'),")
    AAdd(aLinhas, "('CON', 4, 'CON_EMAIL',  'C', 60, 0, 'E-mail'),")
    AAdd(aLinhas, "('CON', 5, 'CON_TEL',    'C', 20, 0, 'Telefone'),")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "('UNI', 1, 'UNI_CODIGO',    'C', 10, 0, 'Unidade'),")
    AAdd(aLinhas, "('UNI', 2, 'UNI_BLOCO',     'C', 10, 0, 'Bloco'),")
    AAdd(aLinhas, "('UNI', 3, 'UNI_FRACAO',    'N', 8,  4, 'Fração Ideal'),")
    AAdd(aLinhas, "('UNI', 4, 'UNI_CONDOMINO', 'C', 10, 0, 'Cód. Condômino'),")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "('DES', 1, 'DES_DESCR',   'C', 80, 0, 'Descrição'),")
    AAdd(aLinhas, "('DES', 2, 'DES_CATEG',   'C', 30, 0, 'Categoria'),")
    AAdd(aLinhas, "('DES', 3, 'DES_VALOR',   'N', 14, 2, 'Valor'),")
    AAdd(aLinhas, "('DES', 4, 'DES_COMPET',  'C', 7,  0, 'Competência'),")
    AAdd(aLinhas, "('DES', 5, 'DES_DTLANC',  'C', 10, 0, 'Data Lançamento'),")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "('COB', 1, 'COB_UNIDADE', 'C', 10, 0, 'Unidade'),")
    AAdd(aLinhas, "('COB', 2, 'COB_COMPET',  'C', 7,  0, 'Competência'),")
    AAdd(aLinhas, "('COB', 3, 'COB_VALOR',   'N', 14, 2, 'Valor'),")
    AAdd(aLinhas, "('COB', 4, 'COB_VENCTO',  'C', 10, 0, 'Vencimento'),")
    AAdd(aLinhas, "('COB', 5, 'COB_STATUS',  'C', 10, 0, 'Status'),")
    AAdd(aLinhas, "('COB', 6, 'COB_DTPAG',   'C', 10, 0, 'Data Pagamento'),")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "('RPT_INADIM', 1, 'RIN_UNIDADE', 'C', 10, 0, 'Unidade'),")
    AAdd(aLinhas, "('RPT_INADIM', 2, 'RIN_COMPET',  'C', 7,  0, 'Competência'),")
    AAdd(aLinhas, "('RPT_INADIM', 3, 'RIN_VALOR',   'N', 14, 2, 'Valor'),")
    AAdd(aLinhas, "('RPT_INADIM', 4, 'RIN_VENCTO',  'C', 10, 0, 'Vencimento'),")
    AAdd(aLinhas, "('RPT_INADIM', 5, 'RIN_ATRASO',  'N', 5,  0, 'Dias de Atraso'),")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "('RPT_EXTRATO', 1, 'REX_COMPET', 'C', 7,  0, 'Competência'),")
    AAdd(aLinhas, "('RPT_EXTRATO', 2, 'REX_VALOR',  'N', 14, 2, 'Valor'),")
    AAdd(aLinhas, "('RPT_EXTRATO', 3, 'REX_VENCTO', 'C', 10, 0, 'Vencimento'),")
    AAdd(aLinhas, "('RPT_EXTRATO', 4, 'REX_STATUS', 'C', 10, 0, 'Status'),")
    AAdd(aLinhas, "('RPT_EXTRATO', 5, 'REX_DTPAG',  'C', 10, 0, 'Data Pagamento'),")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "('RPT_DESCAT', 1, 'RDC_CATEG', 'C', 30, 0, 'Categoria'),")
    AAdd(aLinhas, "('RPT_DESCAT', 2, 'RDC_TOTAL', 'N', 14, 2, 'Total');")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- USR_PERFIL e TOK_PERFIL nasceram como ALTER TABLE ADD COLUMN. O SQLite nao")
    AAdd(aLinhas, "-- tem IF NOT EXISTS para ADD COLUMN, entao reaplicar o schema abortava com")
    AAdd(aLinhas, '-- "duplicate column name" -- e o bootstrap saia 1 sem que ninguem visse.')
    AAdd(aLinhas, "-- Agora as colunas moram no CREATE TABLE das proprias tabelas.")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- Metadados SX3 para CFG_BOLETO")
    AAdd(aLinhas, "INSERT INTO SX3 (X3_ARQUIVO, X3_ORDEM, X3_CAMPO, X3_TIPO, X3_TAMANHO, X3_DECIMAL, X3_TITULO) VALUES")
    AAdd(aLinhas, "('CFG_BOLETO', 1, 'CFG_BANCO',    'C',  4, 0, 'Código do Banco'),")
    AAdd(aLinhas, "('CFG_BOLETO', 2, 'CFG_AGENCIA',  'C', 10, 0, 'Agência'),")
    AAdd(aLinhas, "('CFG_BOLETO', 3, 'CFG_CONTA',    'C', 15, 0, 'Conta Corrente'),")
    AAdd(aLinhas, "('CFG_BOLETO', 4, 'CFG_COBRT',    'C', 15, 0, 'Carta/Cedente ou Convênio'),")
    AAdd(aLinhas, "('CFG_BOLETO', 5, 'CFG_CARTEIRA', 'C', 10, 0, 'Carteira');")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- Metadados SX3 para GCT_TOKEN")
    AAdd(aLinhas, "INSERT INTO SX3 (X3_ARQUIVO, X3_ORDEM, X3_CAMPO, X3_TIPO, X3_TAMANHO, X3_DECIMAL, X3_TITULO) VALUES")
    AAdd(aLinhas, "('GCT_TOKEN', 1, 'TOKEN',      'C', 36, 0, 'Token'),")
    AAdd(aLinhas, "('GCT_TOKEN', 2, 'USR_LOGIN',  'C', 40, 0, 'Gerado por'),")
    AAdd(aLinhas, "('GCT_TOKEN', 3, 'CON_CODIGO', 'C', 10, 0, 'Condômino'),")
    AAdd(aLinhas, "('GCT_TOKEN', 4, 'UNI_CODIGO', 'C', 10, 0, 'Unidade'),")
    AAdd(aLinhas, "('GCT_TOKEN', 5, 'CRIPTADO',   'C', 19, 0, 'Criado em'),")
    AAdd(aLinhas, "('GCT_TOKEN', 6, 'VALIDO_ATE', 'C', 19, 0, 'Válido até'),")
    AAdd(aLinhas, "('GCT_TOKEN', 7, 'USADO',      'N',  1, 0, 'Usado');")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- Metadados SX3 para RPT_COND_COBRANCAS")
    AAdd(aLinhas, "INSERT INTO SX3 (X3_ARQUIVO, X3_ORDEM, X3_CAMPO, X3_TIPO, X3_TAMANHO, X3_DECIMAL, X3_TITULO) VALUES")
    AAdd(aLinhas, "('RPT_COND_COBRANCAS', 1, 'RCC_UNIDADE', 'C', 10, 0, 'Unidade'),")
    AAdd(aLinhas, "('RPT_COND_COBRANCAS', 2, 'RCC_COMPET',  'C',  7, 0, 'Competência'),")
    AAdd(aLinhas, "('RPT_COND_COBRANCAS', 3, 'RCC_VALOR',   'N', 14, 2, 'Valor'),")
    AAdd(aLinhas, "('RPT_COND_COBRANCAS', 4, 'RCC_VENCTO',  'C', 10, 0, 'Vencimento'),")
    AAdd(aLinhas, "('RPT_COND_COBRANCAS', 5, 'RCC_STATUS',  'C', 10, 0, 'Status'),")
    AAdd(aLinhas, "('RPT_COND_COBRANCAS', 6, 'RCC_DTPAG',   'C', 10, 0, 'Data Pagamento');")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- Metadados SX3 para USR_PERFIL")
    AAdd(aLinhas, "INSERT INTO SX3 (X3_ARQUIVO, X3_ORDEM, X3_CAMPO, X3_TIPO, X3_TAMANHO, X3_DECIMAL, X3_TITULO) VALUES")
    AAdd(aLinhas, "('USR', 3, 'USR_PERFIL', 'C', 20, 0, 'Perfil do Usuário');")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- ============================================================================")
    AAdd(aLinhas, "-- Sistema Contábil em Partida Dupla (v2.0)")
    AAdd(aLinhas, "-- 6 tabelas para suportar lançamentos manuais + automáticos, rateio,")
    AAdd(aLinhas, "-- fechamento de período com validação D/C, e auditoria.")
    AAdd(aLinhas, "-- ============================================================================")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS PLANO_CONTAS (")
    AAdd(aLinhas, "    R_E_C_N_O_ INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "    PLA_CODIGO TEXT UNIQUE NOT NULL,")
    AAdd(aLinhas, "    PLA_NOME TEXT NOT NULL,")
    AAdd(aLinhas, "    PLA_TIPO TEXT NOT NULL,")
    AAdd(aLinhas, "    PLA_ATIVO NUMERIC DEFAULT 1,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ NUMERIC,")
    AAdd(aLinhas, "    CHECK(PLA_TIPO IN ('ATIVO', 'PASSIVO', 'RECEITA', 'DESPESA'))")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "CREATE INDEX IF NOT EXISTS IDX_PLANO_CONTAS_ATIVO ON PLANO_CONTAS(PLA_ATIVO, D_E_L_E_T_);")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS REPARTICAO (")
