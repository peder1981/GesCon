    AAdd(aLinhas, "-- AVISOS: Mural de avisos (anúncios publicados pelos admin)")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS AVISOS (")
    AAdd(aLinhas, "    AVI_ID INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "    AVI_TITULO TEXT NOT NULL,")
    AAdd(aLinhas, "    AVI_CORPO TEXT NOT NULL,")
    AAdd(aLinhas, "    AVI_DATA_CRIACAO DATETIME DEFAULT CURRENT_TIMESTAMP,")
    AAdd(aLinhas, "    AVI_ATIVO INTEGER DEFAULT 1 CHECK(AVI_ATIVO IN (0, 1)),")
    AAdd(aLinhas, "    R_E_C_N_O_ INTEGER UNIQUE,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ NUMERIC")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "CREATE INDEX IF NOT EXISTS IDX_AVISOS_ATIVO ON AVISOS(AVI_ATIVO, D_E_L_E_T_);")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- RPT_PORTAL_EXTRATOS: Snapshot de faturas por unidade/mês")
    AAdd(aLinhas, "-- Regenerado 100% (DELETE + INSERT) a cada fechamento de período")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS RPT_PORTAL_EXTRATOS (")
    AAdd(aLinhas, "    REX_ID INTEGER PRIMARY KEY AUTOINCREMENT,")
    AAdd(aLinhas, "    REX_COMPETENCIA TEXT NOT NULL,")
    AAdd(aLinhas, "    REX_UNIDADE TEXT NOT NULL,")
    AAdd(aLinhas, "    REX_VALOR NUMERIC NOT NULL,")
    AAdd(aLinhas, "    REX_VENCIMENTO DATE NOT NULL,")
    AAdd(aLinhas, "    REX_STATUS TEXT DEFAULT 'PENDENTE' CHECK(REX_STATUS IN ('PENDENTE', 'PAGO')),")
    AAdd(aLinhas, "    REX_DATA_PAGAMENTO DATE,")
    AAdd(aLinhas, "    R_E_C_N_O_ INTEGER UNIQUE,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ NUMERIC,")
    AAdd(aLinhas, "    UNIQUE(REX_COMPETENCIA, REX_UNIDADE, D_E_L_E_T_),")
    AAdd(aLinhas, "    FOREIGN KEY(REX_UNIDADE) REFERENCES UNI(UNI_CODIGO)")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "CREATE INDEX IF NOT EXISTS IDX_RPT_PORTAL_EXTRATOS_UNIDADE ON RPT_PORTAL_EXTRATOS(REX_UNIDADE, D_E_L_E_T_);")
    AAdd(aLinhas, "CREATE INDEX IF NOT EXISTS IDX_RPT_PORTAL_EXTRATOS_COMPETENCIA ON RPT_PORTAL_EXTRATOS(REX_COMPETENCIA, D_E_L_E_T_);")
    AAdd(aLinhas, "CREATE INDEX IF NOT EXISTS IDX_RPT_PORTAL_EXTRATOS_STATUS ON RPT_PORTAL_EXTRATOS(REX_STATUS, D_E_L_E_T_);")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "-- RPT_PORTAL_AGENDA: Próximos vencimentos (próximos 12 meses)")
    AAdd(aLinhas, "-- Regenerado 100% (DELETE + INSERT) a cada fechamento de período")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS RPT_PORTAL_AGENDA (")
