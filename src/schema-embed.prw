    AAdd(aLinhas, "    R_E_C_D_E_L_ NUMERIC,")
    AAdd(aLinhas, "    FOREIGN KEY(RAT_LANCAMENTO) REFERENCES LANCAMENTOS(LAN_ID),")
    AAdd(aLinhas, "    FOREIGN KEY(RAT_UNIDADE) REFERENCES UNI(UNI_CODIGO),")
    AAdd(aLinhas, "    CHECK(RAT_VALOR > 0)")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "CREATE INDEX IF NOT EXISTS IDX_RATEIO_LANCAMENTO ON RATEIO_DETALHE(RAT_LANCAMENTO, D_E_L_E_T_);")
