    AAdd(aLinhas, "    REP_DETALHE TEXT,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ NUMERIC")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "CREATE INDEX IF NOT EXISTS IDX_REPARTICAO_ATIVO ON REPARTICAO(REP_ATIVO, D_E_L_E_T_);")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS EXERCICIO (")
