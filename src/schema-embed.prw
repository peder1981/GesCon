    AAdd(aLinhas, "    AUD_RECNO_COB NUMERIC,")
    AAdd(aLinhas, "    AUD_EXERCICIO TEXT,")
    AAdd(aLinhas, "    R_E_C_N_O_ INTEGER,")
    AAdd(aLinhas, "    D_E_L_E_T_ TEXT DEFAULT ' ',")
    AAdd(aLinhas, "    R_E_C_D_E_L_ NUMERIC,")
    AAdd(aLinhas, "    CHECK(AUD_SEVERIDADE IN ('CRITICA', 'AVISO', 'INFO')),")
    AAdd(aLinhas, "    CHECK(AUD_TIPO IN ('DESEQUILIBRIO_CONTABIL', 'COB_ORFAO', 'LAN_ORFAO', 'OUTRO'))")
    AAdd(aLinhas, ");")
    AAdd(aLinhas, "CREATE INDEX IF NOT EXISTS IDX_AUDITORIA_EXERCICIO ON AUDITORIA(AUD_EXERCICIO, AUD_SEVERIDADE, D_E_L_E_T_);")
    AAdd(aLinhas, "")
    AAdd(aLinhas, "CREATE TABLE IF NOT EXISTS RPT_BALANCETE (")
