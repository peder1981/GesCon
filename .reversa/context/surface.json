  "data_model": {
    "tables": 11,
    "tables_list": [
      "CON (condôminos)",
      "UNI (units/apartments)",
      "DES (expenses)",
      "COB (charges/invoices)",
      "USR (admin users, pwd hashed)",
      "RPT_INADIM (delinquency snapshot)",
      "RPT_EXTRATO (extract snapshot)",
      "RPT_DESCAT (expenses-by-category snapshot)",
      "CFG_BOLETO (bank slip config)",
      "GCT_TOKEN (condômino token, 48h)",
      "RPT_COND_COBRANCAS (condômino portal charges snapshot)"
    ],
    "metadata_table": "SX3 (FWMBrowse column metadata: titles, types, sizes)",
    "soft_delete_convention": "Protheus-style (D_E_L_E_T_ = ' ', R_E_C_D_E_L_ = timestamp)",
    "key_decision": "Snapshots (RPT_*) instead of VIEWs — FWMBrowse only supports physical tables with rowid"
  },
